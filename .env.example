# Copy this file to .env and adjust values for your machine.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma-separated. Prod example: ALLOWED_HOSTS=myapp.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme required. Prod example:
# CSRF_TRUSTED_ORIGINS=https://myapp.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. Prod (Railway) injects this for Postgres.
DATABASE_URL=

# Leave EMAIL_HOST unset locally: emails print to the console instead of
# sending. Set it (and the rest below) to switch to real SMTP in production.
DEFAULT_FROM_EMAIL=invoices@example.com
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
