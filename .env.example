# Copy this file to .env and adjust values for your machine.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma-separated. Prod example: ALLOWED_HOSTS=myapp.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme required. Prod example:
# CSRF_TRUSTED_ORIGINS=https://myapp.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. Prod (Railway) injects this for Postgres.
DATABASE_URL=

# Leave RESEND_API_KEY unset locally: emails print to the console instead of
# calling Resend. Set it to send via Resend's HTTP API in production — not
# SMTP, since Railway blocks outbound SMTP ports (587/465).
DEFAULT_FROM_EMAIL=onboarding@resend.dev
RESEND_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
